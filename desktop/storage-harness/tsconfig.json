{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["../../*"],
      "bun:test": ["../../tests/helpers/bun-test-shim.ts"]
    }
  },
  "include": ["main.ts", "gen.ts", "format-steps.ts"]
}
